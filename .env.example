# Public client configuration only. Never add server API/service-role keys here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Set to your real HTTPS production origin (no path/query). No default is published.
EXPO_PUBLIC_SITE_ORIGIN=
EXPO_PUBLIC_LEGAL_OPERATOR=
EXPO_PUBLIC_PRIVACY_EMAIL=
# Enable only after the real operator has reviewed and approved both policies.
EXPO_PUBLIC_LEGAL_REVIEWED=false
# Optional web-only analytics, disabled by default. Requires consent and a configured origin.
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_ANALYTICS_ENDPOINT=https://plausible.io/api/event
