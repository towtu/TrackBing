    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.94.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "decode-uri-component": "file:vendor/decode-uri-component-0.5.0.tgz",
