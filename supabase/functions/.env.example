# LOCAL SERVER-ONLY template. Copy to ignored supabase/functions/.env.
# Supabase CLI provides URL/anon/service-role values locally. Never commit real values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SEARCH_ENABLED=false
BEE_AI_ENABLED=false
# Set only after verifying Google paid-service data handling and adult eligibility.
GEMINI_PAID_DATA_USE_CONFIRMED=false
USDA_API_KEY=
BILLING_PRODUCTS_JSON=[]
BILLING_SANDBOX=true
PAYMONGO_ENABLED=false
PAYMONGO_LIVE=false
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
BILLING_SITE_ORIGIN=
APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY=
# Comma-separated base64 encodings of verified Apple Root CA certificate bytes.
APPLE_ROOT_CA_BASE64=
GOOGLE_PLAY_PACKAGE=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_EMAIL=
# Scheduler-only random value of at least 32 characters. Never give this to clients.
BILLING_RECONCILE_SECRET=
